<!-- СКРИПТ ДЛЯ ПЛАВНОГО РАЗМЫТИЯ ШАПКИ ПРИ СКРОЛЛЕ (как на главной) -->
<script>
const header = document.getElementById('mainHeader');
let ticking = false;
window.addEventListener('scroll', () => {
  if (!ticking) {
    requestAnimationFrame(() => {
      if (window.scrollY > 10) {
        header.style.backdropFilter = 'blur(12px)';
        header.style.backgroundColor = 'rgba(5, 6, 13, 0.85)';
      } else {
        header.style.backdropFilter = 'blur(0px)';
        header.style.backgroundColor = '#05060d';
      }
      ticking = false;
    });
    ticking = true;
  }
});
</script>
